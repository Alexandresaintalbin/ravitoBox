# Valeurs de démonstration locales, publiques, identiques à l'exemple officiel
# d'auto-hébergement Supabase. Elles ne sont pas des secrets de production.
# Pour en générer d'autres : ./scripts/generate-secrets.sh
#
# cp .env.example .env
# docker compose up

POSTGRES_PASSWORD=ravito-local-only-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# URL vues par le navigateur
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=http://localhost:8080/**,http://localhost:5173/**,http://web:8080/**

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

JWT_EXPIRY=3600

# closed : inscriptions fermées (défaut). invite : un code est exigé. open : inscription libre.
# DISABLE_SIGNUP doit valoir true si SIGNUP_MODE=closed, et false sinon.
SIGNUP_MODE=closed
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
# true : aucun e-mail de confirmation, le compte est actif tout de suite.
ENABLE_EMAIL_AUTOCONFIRM=false

SMTP_ADMIN_EMAIL=ravito@localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
# Laisser vides avec Mailpit : GoTrue refuse une authentification SMTP sans chiffrement.
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ravitoBox

# GoTrue n'utilise que l'hôte de API_EXTERNAL_URL. Kong ne publie Auth que sous /auth/v1.
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000

STUDIO_DEFAULT_ORGANIZATION=ravitoBox
STUDIO_DEFAULT_PROJECT=ravitoBox
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=ravito-local-studio-password
PG_META_CRYPTO_KEY=ravito-local-pg-meta-crypto-key-32

KONG_HTTP_PORT=8000
WEB_PORT=8080
STUDIO_PORT=54323
MAILPIT_UI_PORT=8025
POSTGRES_HOST_PORT=54322
